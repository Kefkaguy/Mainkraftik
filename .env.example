INTELLIGENCE_DATABASE_URL=postgresql://intelligence:CHANGE_ME@127.0.0.1:5543/intelligence
INTELLIGENCE_ADMIN_USERNAME=admin
# Generate with python -m intelligence.cli password-hash (interactive prompt).
INTELLIGENCE_ADMIN_PASSWORD_HASH=
INTELLIGENCE_ORIGIN=http://127.0.0.1:3100
INTELLIGENCE_SEC_USER_AGENT=KefTradeIntelligence/0.1 contact@example.com
INTELLIGENCE_ALPACA_KEY=
INTELLIGENCE_ALPACA_SECRET=
INTELLIGENCE_FEED=sip
INTELLIGENCE_ENVIRONMENT=development
INTELLIGENCE_DATA_DIR=.local/data
INTELLIGENCE_MIN_FREE_GB=10
INTELLIGENCE_VISION_MAX_BYTES=2147483648

# The research API gets only a private bridge token. Execution keys belong to
# /etc/keftrade-intelligence/paper.env on production, never NEXT_PUBLIC_*.
INTELLIGENCE_PAPER_SERVICE_URL=http://127.0.0.1:8200
INTELLIGENCE_PAPER_INTERNAL_TOKEN=
INTELLIGENCE_PAPER_DATABASE_URL=postgresql://paperpilot:CHANGE_ME@127.0.0.1:5543/intelligence_paper
INTELLIGENCE_PAPER_KEY=
INTELLIGENCE_PAPER_SECRET=
INTELLIGENCE_PAPER_BASE_URL=https://paper-api.alpaca.markets
INTELLIGENCE_PAPER_ACCOUNT_ID=
INTELLIGENCE_PAPER_FORBIDDEN_ACCOUNT_ID=
INTELLIGENCE_PAPER_EXECUTION_PERMITTED=false

# Optional news-screened daily paper universe; credentials stay backend-only.
INTELLIGENCE_PAPER_DISCOVERY_ENABLED=false
INTELLIGENCE_GROQ_KEY=
INTELLIGENCE_GROQ_MODEL=openai/gpt-oss-120b

# Isolated, pinned financial-news text classifier (paper research only).
INTELLIGENCE_PAPER_SENTIMENT_ENABLED=false
INTELLIGENCE_PAPER_SENTIMENT_URL=http://sentiment:8300

# Execution planning buffer; never a guaranteed profit estimate.
INTELLIGENCE_PAPER_COST_GATE_ENABLED=false
# Cross-market challenger failed the exploratory baseline test; keep off.
INTELLIGENCE_PAPER_MARKET_SHADOW_ENABLED=false

# Controlled Day and Swing paper policy. Deploy the frozen model bundle first.
INTELLIGENCE_PAPER_MAINKRAFT_ENABLED=false
# Optional 20-session Swing expectancy experiment. Use a YYYY-MM-DD start date.
# INTELLIGENCE_PAPER_SWING_TRIAL_START=2026-11-18
# A scaled trial requires the flat dedicated paper book and its frozen $800 intent.
# INTELLIGENCE_PAPER_SWING_TRIAL_NOTIONAL=800
